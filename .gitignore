/agent_fr/eval/llm_blind/*.json
/agent_fr/eval/human/review/
/agent_fr/eval/human/benchmark_*.jsonl
/agent_fr/eval/human/benchmark_dev_phase4.remap.json
/agent_fr/eval/human/ai_adjudication.json
/llm_local/results/
/local_app/runtime/

