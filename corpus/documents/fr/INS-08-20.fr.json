      ]
    },
    {
      "kind": "article",
      "label": "Article 1",
      "number": "1",
      "heading": null,
      "context": {},
      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "La présente instruction a pour objet de modifier les seuils de refinancement applicables aux titres publics négociables donnés en garantie à la Banque d’Algérie par les contreparties aux opérations de politique monétaire.",
      "paragraphs": [
        {
          "text": "La présente instruction a pour objet de modifier les seuils de refinancement applicables aux titres publics négociables donnés en garantie à la Banque d’Algérie par les contreparties aux opérations de politique monétaire.",
          "page_start": 1,
          "page_end": 1
        }
      ]
    },
    {
      "kind": "article",
      "label": "Article 2",
      "number": "2",
      "heading": null,
      "context": {},
      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "L’article 11 de l'instruction n°06-2016 du 1er septembre 2016 relative aux opérations d’open market portant refinancement des banques est modifié et rédigé comme suit :\n« Article 11 : La Banque d’Algérie refinance les banques sur la base des nouveaux seuils fixés conformément à l’annexe VI de la présente instruction ».",
      "paragraphs": [
        {
          "text": "L’article 11 de l'instruction n°06-2016 du 1er septembre 2016 relative aux opérations d’open market portant refinancement des banques est modifié et rédigé comme suit :",
          "page_start": 1,
          "page_end": 1
        },
        {
          "text": "« Article 11 : La Banque d’Algérie refinance les banques sur la base des nouveaux seuils fixés conformément à l’annexe VI de la présente instruction ».",
          "page_start": 1,
          "page_end": 1
        }
      ]
    },
    {
      "kind": "article",
      "label": "Article 3",
      "number": "3",
      "heading": null,
      "context": {},
      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "La présente instruction prend effet à compter de la date de sa signature.\nLe Gouverneur\nAïmene BENABDERRAHMANE\nBANK OF ALGERIA",
      "paragraphs": [
        {
          "text": "La présente instruction prend effet à compter de la date de sa signature.",
