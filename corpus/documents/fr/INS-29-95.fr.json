      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "L'importation des biens d'équipement n'est plus soumise à l'obligation d'obtention des crédits d'au moins trois années d'échéance.",
      "paragraphs": [
        {
          "text": "L'importation des biens d'équipement n'est plus soumise à l'obligation d'obtention des crédits d'au moins trois années d'échéance.",
          "page_start": 1,
          "page_end": 1
        }
      ]
    },
