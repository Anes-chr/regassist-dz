        }
      ]
    },
    {
      "kind": "article",
      "label": "Article 1",
      "number": "1",
      "heading": null,
      "context": {},
      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "La présente instruction a pour objet de modifier les taux visés aux articles 4 et 5 de l’instruction n°02-2004 du 13 mai 2004 relative au régime des réserves obligatoires.",
      "paragraphs": [
        {
          "text": "La présente instruction a pour objet de modifier les taux visés aux articles 4 et 5 de l’instruction n°02-2004 du 13 mai 2004 relative au régime des réserves obligatoires.",
          "page_start": 1,
          "page_end": 1
        }
      ]
    },
    {
      "kind": "article",
      "label": "Article 2",
      "number": "2",
      "heading": null,
      "context": {},
      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "Le taux de rémunération des réserves obligatoires est fixé à 1% par an.",
      "paragraphs": [
        {
          "text": "Le taux de rémunération des réserves obligatoires est fixé à 1% par an.",
          "page_start": 1,
          "page_end": 1
        }
      ]
    },
    {
      "kind": "article",
      "label": "Article 3",
      "number": "3",
      "heading": null,
      "context": {},
      "annexe": null,
      "page_start": 1,
      "page_end": 1,
      "text": "Le taux de pénalité pour la non constitution ou la constitution insuffisante des réserves obligatoire est de quatre (4) points au-dessus de la rémunération des réserves obligatoires.",
      "paragraphs": [
        {
          "text": "Le taux de pénalité pour la non constitution ou la constitution insuffisante des réserves obligatoire est de quatre (4) points au-dessus de la rémunération des réserves obligatoires.",
          "page_start": 1,
          "page_end": 1
        }
      ]
    },
    {
