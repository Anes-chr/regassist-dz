# ==============================================================================
# RegAssist DZ - Production Environment Variables
# ==============================================================================
# Sourced by systemd units and deployment scripts

REGASSIST_DEPLOY_MODE=production
REGASSIST_ALLOWED_HOSTS=127.0.0.1,localhost,regassist.example.com
REGASSIST_ALLOWED_ORIGINS=https://regassist.example.com

LOCAL_APP_PORT=8790
LOCAL_APP_RUNTIME=/opt/regassist-dz/local_app/runtime
PYTHONIOENCODING=utf-8

# Engine data paths (Linux)
REGASSIST_ROOT=/opt/regassist-dz
REGASSIST_DATA_ROOT=/opt/regassist-data
LLM_ROOT=/opt/regassist-data/llm

AGENT_EMBED_DIR=/opt/regassist-data/llm/models/embeddings/multilingual-e5-small
AGENT_RERANK_DIR=/opt/regassist-data/llm/models/rerankers/mmarco-mMiniLMv2-L12-H384
AGENT_VECTOR_DIR=/opt/regassist-data/llm/index
AGENT_CORPUS_DIR=/opt/regassist-data/llm/snapshots/corpus_phase4
AGENT_LOCAL_URL=http://127.0.0.1:8187
AGENT_LLM=local
LOCAL_APP_ALLOW_ENV_OVERRIDES=1
